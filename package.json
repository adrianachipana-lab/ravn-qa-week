{
  "name": "ravn-qa-week",
  "version": "1.0.0",
  "private": true,
  "description": "QA week deliverables — MediBook (medapp-nerdery.vercel.app)",
  "type": "commonjs",
  "scripts": {
    "test:wednesday": "npx playwright test -c wednesday/playwright.config.ts",
    "test:thursday": "npx playwright test -c thursday/playwright.config.ts",
    "test:friday": "npx playwright test -c friday-capstone/playwright.config.ts",
    "test:improvements": "npx playwright test -c improvements/playwright.config.ts",
    "test:all": "npx playwright test -c wednesday/playwright.config.ts; npx playwright test -c thursday/playwright.config.ts; npx playwright test -c friday-capstone/playwright.config.ts; npx playwright test -c improvements/playwright.config.ts",
    "test:regression": "npx playwright test -c thursday/regression.config.ts",
    "report:wednesday": "npx playwright show-report wednesday/playwright-report",
    "report:thursday": "npx playwright show-report thursday/playwright-report",
    "report:friday": "npx playwright show-report friday-capstone/playwright-report",
    "install:browsers": "npx playwright install --with-deps chromium"
  },
  "dependencies": {
    "@axe-core/playwright": "^4.10.0",
    "@playwright/test": "^1.63.0"
  },
  "devDependencies": {
    "dotenv": "^18.0.7"
  }
}
